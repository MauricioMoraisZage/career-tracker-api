// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]
  @@map("users")
}

enum CourseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}
model Course {
  id          String       @id @default(uuid())
  title       String
  platform    String?
  description String?
  status      CourseStatus @default(NOT_STARTED)
  progress    Int          @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  modules CourseModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("courses")
}

enum CourseModuleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
model CourseModule {
  id          String             @id @default(uuid())
  title       String
  description String?
  status      CourseModuleStatus @default(NOT_STARTED)
  order       Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([courseId])
  @@map("course_modules")
}